# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reserved for Phase 4 — no Phase 0/1 code reads this yet.
ANTHROPIC_API_KEY=

# Set to "true" to allow scripts/seed.ts to run (see supabase/seed/dev-seed.ts).
ALLOW_SEED=false

# Calendar integration (Settings -> Calendar). All optional — the app boots
# fine without them; Google/Microsoft just show "Not available" until set.
# Google: console.cloud.google.com -> OAuth client (Web) with the Calendar
# API enabled, redirect URI <origin>/auth/calendar/google/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Microsoft: entra admin center -> App registrations, redirect URI
# <origin>/auth/calendar/microsoft/callback, Graph delegated permissions
# Calendars.Read + offline_access.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Symmetric key used to encrypt calendar OAuth tokens / Apple app-specific
# passwords at rest. Generate with `openssl rand -base64 32`. Required for
# ALL THREE calendar providers (Apple included, even though it has no
# client id/secret of its own) — without it, connecting any calendar fails.
CALENDAR_TOKEN_ENCRYPTION_KEY=
